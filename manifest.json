{
  "manifest_version": 3,
  "name": "MetaPeek",
  "version": "0.0.2",
  "description": "A tiny debugger for the current page\u2019s OG image and metadata.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Inspect page metadata",
    "default_popup": "popup.html"
  }
}
